# Lightweight image for database migrations (Prisma 6 from package-lock.json)
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat openssl

# .env often sets NODE_ENV=production — still install devDependencies (prisma CLI, tsx)
ENV NPM_CONFIG_PRODUCTION=false

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --include=dev

COPY prisma ./prisma
COPY src/lib/password.ts ./src/lib/password.ts

# Use local binary — never `npx prisma` (would download Prisma 7)
RUN ./node_modules/.bin/prisma generate

CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && ./node_modules/.bin/tsx prisma/seed.ts"]
