generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum ActivationCodeStatus {
  ACTIVE
  USED
  REVOKED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  passwordHash        String    @map("password_hash")
  email               String?   @unique
  telegramUsername    String?   @map("telegram_username")
  isDisabled          Boolean   @default(false) @map("is_disabled")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  remnawaveMapping RemnawaveMapping?
  activationCodes  ActivationCode[]  @relation("UsedByUser")
  sessions         UserSession[]
  auditLogs        AuditLog[]        @relation("UserAuditLogs")

  @@index([username])
  @@index([email])
  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Admin {
  id                  String    @id @default(cuid())
  username            String    @unique
  passwordHash        String    @map("password_hash")
  role                AdminRole @default(ADMIN)
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  createdCodes ActivationCode[] @relation("CreatedByAdmin")
  sessions     AdminSession[]
  auditLogs    AuditLog[]       @relation("AdminAuditLogs")

  @@map("admins")
}

model AdminSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  adminId      String   @map("admin_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model RemnawaveMapping {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  remnawaveUuid    String    @unique @map("remnawave_uuid")
  remnawaveUsername String   @map("remnawave_username")
  subscriptionUrl  String?   @map("subscription_url")
  expireAt         DateTime? @map("expire_at")
  status           String?   @map("status")
  lastSyncAt       DateTime? @map("last_sync_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([remnawaveUuid])
  @@map("remnawave_mappings")
}

model ActivationCode {
  id              String               @id @default(cuid())
  code            String               @unique
  durationDays    Int                  @map("duration_days")
  status          ActivationCodeStatus @default(ACTIVE)
  expiresAt       DateTime?            @map("expires_at")
  usedAt          DateTime?            @map("used_at")
  usedByUserId    String?              @map("used_by_user_id")
  createdByAdminId String              @map("created_by_admin_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  usedByUser    User? @relation("UsedByUser", fields: [usedByUserId], references: [id], onDelete: SetNull)
  createdByAdmin Admin @relation("CreatedByAdmin", fields: [createdByAdminId], references: [id])

  @@index([status])
  @@index([durationDays])
  @@index([createdAt])
  @@map("activation_codes")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType @map("actor_type")
  userId     String?        @map("user_id")
  adminId    String?        @map("admin_id")
  action     String
  details    Json?
  ipAddress  String?        @map("ip_address")
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  user  User?  @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  admin Admin? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  count     Int      @default(1)
  windowStart DateTime @map("window_start")
  expiresAt DateTime @map("expires_at")

  @@unique([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_entries")
}
