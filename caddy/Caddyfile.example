# Complete Caddyfile for neo-vpn.com stack
# Copy to /opt/remnawave/caddy/Caddyfile on the server
#
# NeoVPN portal container: neovpn-web:3000
# Must be on the same Docker network as Caddy (see CADDY_NETWORK in NeoVPN .env)

# --- NeoVPN customer portal ---
https://neo-vpn.com {
	reverse_proxy neovpn-web:3000
}

https://www.neo-vpn.com {
	redir https://neo-vpn.com{uri}
}

# --- Remnawave panel ---
https://panel.neo-vpn.com {
	reverse_proxy remnawave:3000
}

# --- Remnawave subscription page ---
https://sub.neo-vpn.com {
	reverse_proxy remnawave-subscription-page:3010
}

# --- Default HTTPS catch-all (internal TLS) ---
:443 {
	tls internal
	respond 204
}
