# Example: host nginx already uses 80/443 — proxy to NeoVPN app container
#
# Install on the host (not inside Docker):
#   sudo cp nginx/host-reverse-proxy.conf.example /etc/nginx/sites-available/neovpn
#   sudo ln -s /etc/nginx/sites-available/neovpn /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Start NeoVPN WITHOUT binding host 80/443:
#   docker compose up -d postgres app
#   (do not start the nginx service, or set HTTP_PORT=8080 in .env)

server {
    listen 80;
    server_name your-domain.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# After obtaining TLS certificate, add a similar server { listen 443 ssl; ... } block.
