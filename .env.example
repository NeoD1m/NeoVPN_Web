# NeoVPN Portal Environment Configuration

# Application
NODE_ENV=production
APP_URL=https://neo-vpn.com
PORT=3000

# Docker network shared with Caddy (must match network where Caddy runs)
# Find on server: docker inspect caddy --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
CADDY_NETWORK=remnawave-network

# Database
DATABASE_URL=postgresql://neovpn:your_secure_password@postgres:5432/neovpn?schema=public

# Security - REQUIRED: Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_character_minimum_encryption_key_here

# Remnawave (can also be configured via Admin Panel)
REMNAWAVE_API_URL=https://your-remnawave-panel.com
REMNAWAVE_API_KEY=your_remnawave_bearer_token
REMNAWAVE_SQUAD_NAME=MainSquad

# Initial Admin (used by seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdmin123!

# Backup
BACKUP_DIR=/app/backups

# PostgreSQL (for Docker Compose)
POSTGRES_USER=neovpn
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=neovpn
